#LeetCode 62


*Top-Down Approach*

class Solution {
    public int uniquePaths(int m, int n) {
        int[][] dp=new int[m+1][n+1];
        for(int[] row:dp){
            Arrays.fill(row,-1);
        }
        return paths(0,0,m,n,dp);
    }
    public int paths(int r,int c,int m,int n,int[][] dp){
        if(r==m-1 && c==n-1){
            return 1;
        }
        if(r>=m || c>=n){
            return 0;
        }
        if(dp[r][c]!=-1){
            return dp[r][c];
        }
        int a=paths(r+1,c,m,n,dp);
        int b=paths(r,c+1,m,n,dp);
        return dp[r][c]=a+b;
    }
}
